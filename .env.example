# Copy to .env.local (git-ignored) and restart `npm run dev`.
# Vite inlines VITE_* variables into the bundle: keep this for local
# development, and leave it unset in a deployed build so each user
# saves their own key in the assistant settings instead.
VITE_OPENROUTER_API_KEY=sk-or-v1-...
# Any OpenRouter model id. Tool-calling models give the best results.
VITE_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Accounts: Supabase project URL and anon (public) key — Project Settings → API.
# Leave both unset to use browser-local accounts (no backend).
# Google and GitHub sign-in ride on the same keys; switch each provider on in
# Supabase → Authentication → Providers. See docs/accounts.md.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# The SOAP Migration Workbench (/soap) and its bridge host. Off unless this
# is exactly "on"; see docs/soap-migration-workbench.md.
# VITE_SOAP_WORKBENCH=on

# The address the site is served from. Canonical links, the sitemap and
# social cards are built from it; set it before deploying.
VITE_SITE_URL=https://vizroute.app
